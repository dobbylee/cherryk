{
  "name": "cherryk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "test:backend": "./backend/gradlew -p backend test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build:backend": "./backend/gradlew -p backend bootJar"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
